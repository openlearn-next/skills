{
  "standard": {
    "name": "义务教育信息科技课程标准（2022年版）",
    "publisher": "中华人民共和国教育部",
    "year": 2022,
    "stage": "初中（7-9年级）"
  },
  "modules": [
    {
      "id": "data-and-coding",
      "name": "数据与编码",
      "description": "理解数据的基本概念与编码原理，掌握常见数据的数字表示方法，认识数据编码对社会发展的作用。",
      "grade_level": ["7", "8"],
      "topics": [
        "数据与信息",
        "二进制与数制转换",
        "字符编码",
        "多媒体数据编码",
        "数据压缩",
        "数据存储与单位",
        "模拟与数字信号"
      ],
      "core_competencies": [
        "信息意识",
        "计算思维",
        "数字化学习与创新",
        "信息社会责任"
      ]
    },
    {
      "id": "algorithms-and-programming",
      "name": "算法与程序设计",
      "description": "理解算法的基本概念与特征，掌握顺序、分支、循环三种基本控制结构，能使用流程图描述简单算法。",
      "grade_level": ["7", "8", "9"],
      "topics": [
        "算法概念与特征",
        "流程图与伪代码",
        "顺序结构",
        "分支结构",
        "循环结构",
        "数组与列表",
        "简单算法策略"
      ],
      "core_competencies": [
        "计算思维",
        "数字化学习与创新"
      ]
    },
    {
      "id": "networks-and-security",
      "name": "网络与信息安全",
      "description": "了解计算机网络的基本组成与工作原理，理解信息安全的基本概念，增强网络安全防护意识。",
      "grade_level": ["8", "9"],
      "topics": [
        "网络组成与分类",
        "TCP/IP协议基础",
        "互联网应用",
        "信息安全概念",
        "加密技术基础",
        "网络安全防护",
        "信息伦理与法规"
      ],
      "core_competencies": [
        "信息意识",
        "信息社会责任"
      ]
    },
    {
      "id": "ai-fundamentals",
      "name": "人工智能基础",
      "description": "了解人工智能的基本概念、发展历程和典型应用，认识人工智能对社会发展的影响。",
      "grade_level": ["8", "9"],
      "topics": [
        "人工智能概念与发展",
        "机器学习基础",
        "计算机视觉",
        "自然语言处理",
        "AI伦理与社会影响"
      ],
      "core_competencies": [
        "信息意识",
        "计算思维",
        "信息社会责任"
      ]
    },
    {
      "id": "info-processing-and-digital-learning",
      "name": "信息处理与数字化学习",
      "description": "掌握信息获取、加工、表达与交流的基本方法，利用数字化工具进行学习与创新。",
      "grade_level": ["7", "8"],
      "topics": [
        "信息获取与评价",
        "信息加工与表达",
        "数字化工具应用",
        "协作学习与创新"
      ],
      "core_competencies": [
        "数字化学习与创新",
        "信息意识"
      ]
    }
  ]
}
