{
  "id": "teaching-quality-evaluator",
  "name": "教学设计质量评估器",
  "version": "1.0.0",
  "description": "对完整教学设计进行多维度质量评分，满分 100 分",

  "dimensions": [
    {
      "name": "课程标准对齐度",
      "weight": 25,
      "maxScore": 25,
      "criteria": ["contentRequirements 引用完整性", "coreCompetencies 覆盖度", "academicQuality 水平匹配", "teachingSuggestions 采纳度"],
      "scoreMap": { "优秀": [21,25], "良好": [17,20], "合格": [13,16], "待改进": [0,12] }
    },
    {
      "name": "教学目标质量",
      "weight": 20,
      "maxScore": 20,
      "criteria": ["五行目标完整度", "目标可观测性", "目标与课标对齐度", "目标难度适切性"],
      "scoreMap": { "优秀": [17,20], "良好": [13,16], "合格": [10,12], "待改进": [0,9] }
    },
    {
      "name": "活动设计质量",
      "weight": 20,
      "maxScore": 20,
      "criteria": ["EDP流程完整性", "真实情境质量", "学生自主性", "活动时间合理性"],
      "scoreMap": { "优秀": [17,20], "良好": [13,16], "合格": [10,12], "待改进": [0,9] }
    },
    {
      "name": "评价一致性",
      "weight": 15,
      "maxScore": 15,
      "criteria": ["目标-评价对应", "Rubric规范性", "评价方式多样性", "学习证据完整性"],
      "scoreMap": { "优秀": [13,15], "良好": [10,12], "合格": [7,9], "待改进": [0,6] }
    },
    {
      "name": "创新与反思",
      "weight": 10,
      "maxScore": 10,
      "criteria": ["创新设计元素", "跨学科联系", "反思深度", "改进建议可行性"],
      "scoreMap": { "优秀": [9,10], "良好": [7,8], "合格": [5,6], "待改进": [0,4] }
    },
    {
      "name": "资源完整性",
      "weight": 10,
      "maxScore": 10,
      "criteria": ["教学资源覆盖度", "安全规范完整性", "PPT/板书质量", "拓展资源丰富度"],
      "scoreMap": { "优秀": [9,10], "良好": [7,8], "合格": [5,6], "待改进": [0,4] }
    }
  ],

  "grading": {
    "A": { "min": 90, "label": "优秀", "action": "直接发布" },
    "B": { "min": 80, "label": "良好", "action": "建议优化后发布" },
    "C": { "min": 70, "label": "合格", "action": "需要修改后发布" },
    "D": { "min": 0, "label": "待改进", "action": "需要重新生成" }
  }
}
