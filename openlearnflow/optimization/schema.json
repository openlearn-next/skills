{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quality Optimization Schema",
  "description": "教学设计质量优化 Schema 定义",
  "type": "object",
  "required": ["id", "evaluator", "diagnostics", "strategies"],
  "properties": {
    "id": { "type": "string" },
    "evaluator": {
      "type": "object",
      "required": ["dimensions"],
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "weight", "criteria"],
            "properties": {
              "name": { "type": "string" },
              "weight": { "type": "number" },
              "criteria": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "category", "severity"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "category": { "type": "string" },
              "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
              "detectionRule": { "type": "string" },
              "affectedExperts": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "strategies": {
      "type": "object",
      "properties": {
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["issueId", "strategy", "action"],
            "properties": {
              "issueId": { "type": "string" },
              "strategy": { "type": "string" },
              "action": { "type": "string" },
              "autoApplicable": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
