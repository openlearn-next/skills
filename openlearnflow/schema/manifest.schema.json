{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlearn.ai/schemas/skill-manifest.schema.json",
  "title": "Skill Manifest Schema",
  "description": "Teaching Design Skill Manifest 的 JSON Schema 定义",
  "type": "object",

  "required": ["id", "name", "version", "description", "type", "runtime", "capabilities", "workflows", "permissions"],

  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Skill 唯一标识（kebab-case）",
      "minLength": 3,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "description": "Skill 英文名称",
      "minLength": 1,
      "maxLength": 100
    },
    "displayName": {
      "type": "string",
      "description": "Skill 显示名称",
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$",
      "description": "语义化版本号"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "type": {
      "type": "string",
      "enum": ["skill", "plugin", "template", "provider"],
      "description": "包类型"
    },
    "author": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "license": { "type": "string" },
    "runtime": {
      "type": "object",
      "required": ["minVersion"],
      "properties": {
        "minVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "maxVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["analysis", "design", "generation", "curation", "review"] },
          "description": { "type": "string" },
          "input": { "type": "array", "items": { "type": "string" } },
          "output": { "type": "array", "items": { "type": "string" } },
          "expert": { "type": "string" },
          "timeout": { "type": "integer", "minimum": 1000 }
        }
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "steps"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["sequential", "parallel", "conditional"] },
          "description": { "type": "string" },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "experts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "prompt": { "type": "string" }
        }
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "schema": { "type": "string" },
          "producer": { "type": "string" },
          "readonly": { "type": "boolean" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "format": { "type": "string", "enum": ["markdown", "json", "docx", "pptx", "pdf"] },
          "template": { "type": "string" },
          "default": { "type": "boolean" }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "skills": { "type": "array", "items": { "type": "string" } },
        "plugins": { "type": "array", "items": { "type": "string" } },
        "providers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "language": { "type": "string" },
        "locale": { "type": "string" },
        "subject": { "type": "string" },
        "gradeLevels": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "categories": { "type": "array", "items": { "type": "string" } },
        "homepage": { "type": "string" },
        "repository": { "type": "string" },
        "icon": { "type": "string" }
      }
    }
  }
}
