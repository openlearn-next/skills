{
  "format": "docx",
  "name": "课时教学设计 Word 模板",
  "version": "1.0.0",
  "description": "DocxGenerator 使用的文档结构描述，定义各章节的样式和内容映射",

  "styles": {
    "fontFamily": "SimSun",
    "titleFont": "SimHei",
    "titleSize": 26,
    "heading1Size": 18,
    "heading2Size": 15,
    "bodySize": 12
  },

  "sections": [
    { "id": "cover", "title": "封面", "template": "技术与工程 · 教学设计" },
    { "id": "overview", "title": "教学概览", "layout": "table" },
    { "id": "curriculum", "title": "课程标准分析", "layout": "heading+body" },
    { "id": "textbook", "title": "教材分析", "layout": "heading+body" },
    { "id": "knowledge", "title": "知识图谱", "layout": "heading+body" },
    { "id": "student", "title": "学情分析", "layout": "heading+body" },
    { "id": "objectives", "title": "教学目标", "layout": "bullet_list" },
    { "id": "strategy", "title": "教学策略", "layout": "heading+body" },
    { "id": "process", "title": "教学过程", "layout": "table" },
    { "id": "activities", "title": "学习活动", "layout": "heading+body" },
    { "id": "assessment", "title": "评价方案", "layout": "table" },
    { "id": "resources", "title": "教学资源", "layout": "bullet_list" },
    { "id": "reflection", "title": "教学反思", "layout": "heading+body" },
    { "id": "appendix", "title": "附录", "layout": "table" }
  ]
}
