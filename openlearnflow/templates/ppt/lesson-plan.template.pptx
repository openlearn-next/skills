{
  "format": "pptx",
  "name": "课时教学设计 PPT 模板",
  "version": "1.0.0",
  "description": "PPTGenerator 使用的幻灯片结构描述",

  "theme": {
    "primaryColor": "1B3A5C",
    "accentColor": "2B579A",
    "backgroundColor": "FFFFFF",
    "titleFont": "SimHei",
    "bodyFont": "Microsoft YaHei",
    "titleSize": 32,
    "bodySize": 16
  },

  "slides": [
    { "id": "cover", "title": "封面", "layout": "TITLE", "background": "1B3A5C" },
    { "id": "agenda", "title": "目录", "layout": "SECTION", "background": "2B579A" },
    { "id": "overview", "title": "教学概览", "layout": "TABLE" },
    { "id": "curriculum", "title": "课程标准分析", "layout": "TITLE_CONTENT" },
    { "id": "student", "title": "学情分析", "layout": "TITLE_CONTENT" },
    { "id": "objectives", "title": "教学目标", "layout": "BULLETS" },
    { "id": "strategy", "title": "教学策略", "layout": "TITLE_CONTENT" },
    { "id": "process", "title": "教学过程", "layout": "BULLETS" },
    { "id": "activities", "title": "学习活动", "layout": "BULLETS" },
    { "id": "assessment", "title": "评价方案", "layout": "TABLE" },
    { "id": "resources", "title": "教学资源", "layout": "TABLE" },
    { "id": "reflection", "title": "教学反思", "layout": "TITLE_CONTENT" },
    { "id": "summary", "title": "总结", "layout": "TITLE_CONTENT" }
  ]
}
