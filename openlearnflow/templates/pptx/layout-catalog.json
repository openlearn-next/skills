{
  "name": "OpenLearn Flow PPT Layout Catalog",
  "version": "1.0.0",
  "colorScheme": {
    "primary": "#4A7C59",
    "secondary": "#C15937",
    "background": "#F4F1DE",
    "dark": "#2C2C2C",
    "white": "#FFFFFF",
    "muted": "#7F8C8D",
    "lightGreen": "#6B9D73"
  },
  "layouts": [
    {
      "id": "cover",
      "file": "cover.html",
      "name": "封面",
      "slots": {
        "tag": { "css": ".cover .tag", "sample": "项目式学习 · 高一 技术与工程" },
        "title": { "css": ".cover h1", "sample": "都江堰水利工程" },
        "subtitle": { "css": ".cover .sub", "sample": "破译千年工程的系统密码" },
        "footer": { "css": ".cover .foot", "sample": "OpenLearn Flow" }
      },
      "bestFor": "title-slide"
    },
    {
      "id": "section",
      "file": "section.html",
      "name": "章节标题",
      "slots": {
        "title": { "css": ".sec h1", "sample": "课程标准分析" }
      },
      "bestFor": "section-header"
    },
    {
      "id": "two-col",
      "file": "two-col.html",
      "name": "双栏对比",
      "slots": {
        "section": { "css": ".page .header .num", "sample": "课程标准" },
        "title": { "css": ".page .header h1", "sample": "课程依据与素养目标" },
        "leftCards": { "css": ".page .grid .col:nth-child(1) .card", "array": true },
        "rightCards": { "css": ".page .grid .col:nth-child(2) .card", "array": true }
      },
      "bestFor": "two-column, comparison, analysis-vs-requirement"
    },
    {
      "id": "three-col",
      "file": "three-col.html",
      "name": "三栏卡片",
      "slots": {
        "section": { "css": ".page .header .num", "sample": "系统结构" },
        "title": { "css": ".page .header h1", "sample": "三大工程子系统" },
        "cards": { "array": true, "each": { "header": ".card .top p", "body": ".card .body p" } }
      },
      "bestFor": "three-column, cards, subsystems"
    },
    {
      "id": "table",
      "file": "table.html",
      "name": "结构化表格",
      "slots": {
        "section": { "css": ".page .header .num", "sample": "教学目标" },
        "title": { "css": ".page .header h1", "sample": "五维目标体系" },
        "columns": { "array": true },
        "rows": { "array": true }
      },
      "bestFor": "table, objectives, rubric, evaluation"
    },
    {
      "id": "features",
      "file": "features.html",
      "name": "特征网格（2×N）",
      "slots": {
        "section": { "css": ".page .header .num", "sample": "系统特征" },
        "title": { "css": ".page .header h1", "sample": "系统五大特征" },
        "items": { "array": true, "each": { "number": ".item .icon p", "name": ".item .txt h3", "desc": ".item .txt p" } }
      },
      "bestFor": "features, concepts-list, numbered-items"
    },
    {
      "id": "flow",
      "file": "flow.html",
      "name": "流程图",
      "slots": {
        "section": { "css": ".page .header .num", "sample": "分析方法" },
        "title": { "css": ".page .header h1", "sample": "白箱法" },
        "steps": { "array": true },
        "boxes": { "array": true }
      },
      "bestFor": "flow-diagram, process, methodology"
    },
    {
      "id": "timeline",
      "file": "timeline.html",
      "name": "时间线",
      "slots": {
        "section": { "css": ".page .header .num", "sample": "持续迭代" },
        "title": { "css": ".page .header h1", "sample": "系统优化" },
        "events": { "array": true, "each": { "year": ".node .year", "event": ".node .event" } },
        "topics": { "array": true }
      },
      "bestFor": "timeline, history, evolution"
    },
    {
      "id": "experiment",
      "file": "experiment.html",
      "name": "实验步骤",
      "slots": {
        "section": { "css": ".page .header .num", "sample": "动手验证" },
        "title": { "css": ".page .header h1", "sample": "弯道环流实验" },
        "leftSteps": { "array": true },
        "rightSteps": { "array": true },
        "safety": { "css": ".safety p", "optional": true }
      },
      "bestFor": "numbered-steps, experiment, procedure"
    },
    {
      "id": "task",
      "file": "task.html",
      "name": "任务卡片",
      "slots": {
        "section": { "css": ".page .header .num", "sample": "能力迁移" },
        "title": { "css": ".page .header h1", "sample": "从都江堰到你的世界" },
        "quote": { "css": ".page .quote", "optional": true },
        "taskTitle": { "css": ".task h3", "sample": "迁移任务" },
        "taskDescription": { "css": ".task p" },
        "constraints": { "css": ".task .constraints", "optional": true },
        "tools": { "array": true }
      },
      "bestFor": "task-card, assignment, exercise"
    },
    {
      "id": "closing",
      "file": "closing.html",
      "name": "总结",
      "slots": {
        "title": { "css": ".end h1", "sample": "项目总结" },
        "subtitle": { "css": ".end .sub", "sample": "从千年工程到系统思维" },
        "cards": { "array": true, "each": { "icon": ".card .icon", "label": ".card h3", "desc": ".card p" } }
      },
      "bestFor": "closing-four-point, summary"
    }
  ],
  "routing": {
    "title-slide": "cover",
    "two-column": "two-col",
    "three-column": "three-col",
    "table": "table",
    "flow-diagram": "flow",
    "timeline": "timeline",
    "numbered-steps": "experiment",
    "task-card": "task",
    "closing-four-point": "closing",
    "two-row-grid": "features",
    "features": "features",
    "image-left-text-right": "two-col",
    "diagram-with-annotations": "two-col",
    "section-header": "section",
    "comparison": "two-col"
  }
}
