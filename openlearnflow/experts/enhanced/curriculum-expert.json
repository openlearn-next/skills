{
  "id": "curriculum-expert",
  "name": "课程标准专家（增强版）",
  "base": "../curriculum-expert.json",
  "version": "1.1.0",
  "description": "增强版课程标准分析专家，集成知识检索和课程标准模型",

  "knowledgeSources": [
    { "source": "curriculum-competencies", "path": "knowledge/curriculum/core-competencies.json", "type": "json" },
    { "source": "curriculum-standard", "path": "knowledge/curriculum-standard/standards/technology-engineering.json", "type": "json" },
    { "source": "competency-mapping", "path": "knowledge/curriculum-standard/mappings/competency-objective-map.json", "type": "json" }
  ],

  "retrievalPolicy": {
    "policyId": "curriculum-policy",
    "path": "knowledge/retrieval/policies/curriculum-policy.json",
    "strategy": "keyword",
    "maxResults": 5,
    "contextKey": "retrievedCurriculum"
  },

  "reasoningRules": [
    { "rule": "curriculum-alignment", "description": "所有分析必须引用课程标准原文条目" },
    { "rule": "competency-positioning", "description": "明确本课培养的核心素养维度和水平层级" },
    { "rule": "knowledge-positioning", "description": "确定本课在课程标准知识体系中的位置" },
    { "rule": "quality-level", "description": "判定本课应达到的学业质量水平(1-4级)" }
  ],

  "outputSchema": {
    "required": ["coursePosition", "contentRequirements", "coreCompetencies", "academicQuality"],
    "knowledgeInjected": {
      "standardsReference": "引用 curriculum-standard 中的 contentDomains 条目",
      "competencyLevels": "引用 competency-mapping 中的水平和指标"
    }
  }
}
