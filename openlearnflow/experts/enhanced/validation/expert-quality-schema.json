{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expert Quality Validation Schema",
  "description": "增强版 Expert 输出质量校验 Schema",
  "type": "object",
  "required": ["id", "version", "qualityDimensions"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "qualityDimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "weight", "rules"],
        "properties": {
          "name": { "type": "string" },
          "weight": { "type": "number" },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "description", "severity"],
              "properties": {
                "id": { "type": "string" },
                "description": { "type": "string" },
                "severity": { "type": "string", "enum": ["critical", "warning"] },
                "check": { "type": "string" },
                "expertIds": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
