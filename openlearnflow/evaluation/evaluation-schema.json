{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teaching Design Skill Evaluation Schema",
  "description": "教学设计技能评估标准，包含 5 大维度 20 项指标",
  "type": "object",

  "properties": {
    "evaluationId": { "type": "string", "description": "评估ID" },
    "skillId": { "type": "string", "const": "teaching-design" },
    "version": { "type": "string", "const": "1.0.0" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "workflowId": { "type": "string" },
    "testCaseId": { "type": "string" },
    "totalScore": { "type": "integer", "minimum": 0, "maximum": 100 },

    "dimensions": {
      "type": "object",
      "properties": {
        "technical": { "$ref": "#/$defs/Dimension" },
        "workflow": { "$ref": "#/$defs/Dimension" },
        "expert": { "$ref": "#/$defs/Dimension" },
        "output": { "$ref": "#/$defs/Dimension" },
        "educational": { "$ref": "#/$defs/Dimension" }
      },
      "required": ["technical", "workflow", "expert", "output", "educational"]
    },

    "passThreshold": { "type": "integer", "default": 70 },
    "passed": { "type": "boolean" },
    "summary": { "type": "string" },
    "recommendations": { "type": "array", "items": { "type": "string" } }
  },

  "$defs": {
    "Dimension": {
      "type": "object",
      "required": ["score", "maxScore", "criteria"],
      "properties": {
        "score": { "type": "integer", "minimum": 0 },
        "maxScore": { "type": "integer", "minimum": 1, "maximum": 100 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "passed", "score", "maxScore"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "passed": { "type": "boolean" },
              "score": { "type": "integer" },
              "maxScore": { "type": "integer" },
              "comment": { "type": "string" }
            }
          }
        },
        "comment": { "type": "string" }
      }
    }
  }
}
